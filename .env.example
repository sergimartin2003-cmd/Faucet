VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# For legacy projects, use VITE_SUPABASE_ANON_KEY instead.
# Optional: Cloudflare Turnstile site key. Also enable CAPTCHA in Supabase → Authentication → Attack Protection.
# VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
# Optional: public contact address shown on legal pages
# VITE_CONTACT_EMAIL=soporte@example.com
